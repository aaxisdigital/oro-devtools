<?xml version="1.0" encoding="UTF-8"?>
<!--
    Unit tests of AaxisDevToolsBundle. PHPUnit itself and the Oro platform come from the host
    application's vendor/ directory (see Tests/bootstrap.php); this bundle has no dev dependencies.
    Coverage needs a driver (pcov/xdebug) and measures everything Sonar counts: Migrations and the
    bundle class are left out here for the same reason they are left out of sonar.coverage.exclusions.
-->
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
        bootstrap="Tests/bootstrap.php"
        colors="true"
        cacheResult="false"
        failOnRisky="true"
        failOnWarning="true"
        beStrictAboutOutputDuringTests="true"
        beStrictAboutTestsThatDoNotTestAnything="true">
    <testsuites>
        <testsuite name="unit">
            <directory>Tests/Unit</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="-1"/>
    </php>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">.</directory>
        </include>
        <exclude>
            <directory>Tests</directory>
            <directory>Migrations</directory>
            <directory>Resources</directory>
            <directory>vendor</directory>
            <directory>node_modules</directory>
            <file>AaxisDevToolsBundle.php</file>
        </exclude>
    </coverage>
</phpunit>
